# ==============================================================================
# FUERZAVERIFICADA - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in your Vercel Project Settings (Settings -> Environment Variables).

# Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Public safe key for client-side queries and auth)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon / public)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: Supabase Service Role Key (Only used server-side in secure API routes / migrations)
# DO NOT expose this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production Domain URL (Used for OAuth redirects in production, e.g. https://fuerzaverificada.com)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
